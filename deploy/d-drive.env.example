# Deployment environment for ../kaneoB-data/.env.
# The README initialization commands generate both secrets below.
KANEO_CLIENT_URL=http://localhost:5173
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=kaneo
POSTGRES_USER=kaneo
POSTGRES_PASSWORD=
AUTH_SECRET=

